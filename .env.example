# Copiez ce fichier vers .env et renseignez de vraies valeurs.
# Ne commitez JAMAIS le fichier .env réel (il est exclu par .gitignore).

# Django
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données (laisser vide pour utiliser SQLite en local)
DATABASE_URL=

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Durcissement production (n'a d'effet que si DEBUG=False)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
